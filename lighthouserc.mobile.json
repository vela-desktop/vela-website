{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/blog/",
        "http://localhost/blog/frame-clock/",
        "http://localhost/blog/not-vibecoding/",
        "http://localhost/it/blog/not-vibecoding/",
        "http://localhost/blog/topics/renderer/",
        "http://localhost/install/",
        "http://localhost/changes/",
        "http://localhost/faq/"
      ],
      "numberOfRuns": 1,
      "settings": {}
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "errors-in-console": [
          "error",
          {
            "maxLength": 0
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/mobile"
    }
  }
}
