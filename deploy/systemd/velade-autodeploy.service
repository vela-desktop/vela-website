[Unit]
Description=Publish velade.org when GitHub main changes
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=velade
Group=velade
Environment=HOME=/var/lib/velade
Environment=PATH=/opt/node-v24/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/var/lib/velade/vela-website/deploy/autodeploy.sh
TimeoutStartSec=15min
Nice=10

# The build only needs its clone, the site directory and the network.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0022
ReadWritePaths=/var/lib/velade /var/www/velade.org
