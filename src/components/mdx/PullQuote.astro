---
// A sentence of the text set large, for MDX journal entries. Use it in place
// of the sentence, not as a copy of it: a screen reader reads it once, as
// part of the text.
//
//   import PullQuote from '../../components/mdx/PullQuote.astro';
//   <PullQuote>A test that passes with the bug still there isn't a test.</PullQuote>
---

<div class="pullquote"><slot /></div>

<style>
  .pullquote {
    grid-column: wide;
    margin-block: 2.4em 2.2em;
    padding: 1.4rem 0 1.4rem clamp(1.25rem, 4vw, 2.5rem);
    border-left: 2px solid var(--teal);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 1.85rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--text);
    text-wrap: balance;
  }

  .pullquote + :global(*) {
    margin-top: 0;
  }
</style>
