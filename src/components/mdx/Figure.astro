---
// An optimized image with an optional caption, for MDX journal entries.
//
//   import Figure from '../../components/mdx/Figure.astro';
//   import shot from './snap.webp';
//   <Figure src={shot} alt="…" caption="…" width="wide" />
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** content (default) · wide · full */
  width?: 'content' | 'wide' | 'full';
}

const { src, alt, caption, width = 'content' } = Astro.props;
const sizes = {
  content: '(max-width: 44rem) 94vw, 40rem',
  wide: '(max-width: 58rem) 94vw, 54rem',
  full: '100vw',
}[width];
---

<figure class:list={['figure', `figure--${width}`]}>
  <Picture
    src={src}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={[480, 800, 1200, 1600, 1920]}
    sizes={sizes}
  />
  {(caption || Astro.slots.has('default')) && (
    <figcaption>
      {caption}
      <slot />
    </figcaption>
  )}
</figure>
