---
// An ordered list drawn as a sequence of steps, for MDX journal entries:
// a workflow, a pipeline, the stages of a piece of work. Write a normal
// Markdown ordered list inside it; a **bold** start becomes the step's name.
//
//   import Steps from '../../components/mdx/Steps.astro';
//   <Steps>
//
//   1. **Design document**, reviewed two or three times;
//   2. **CI on CPU**;
//
//   </Steps>
//
// variant="row" lays short steps out side by side (B0 → B1 → B2 → B3),
// and stacks them again on narrow screens. marker="dot" drops the numbers,
// for steps that are already named (B0, B1…).
export interface Props {
  title?: string;
  /** column (default) · row */
  variant?: 'column' | 'row';
  /** number (default) · dot */
  marker?: 'number' | 'dot';
}

const { title, variant = 'column', marker = 'number' } = Astro.props;
---

<div class:list={['steps', `steps--${variant}`, `steps--${marker}`]}>
  {title && <p class="steps__title">{title}</p>}
  <slot />
</div>

<style>
  .steps {
    font-family: var(--font-body);
    font-size: 0.86em;
    line-height: 1.55;
  }

  .steps--row {
    grid-column: wide;
  }

  .steps__title {
    margin-bottom: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--teal);
  }

  .steps :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps :global(li) {
    position: relative;
    margin: 0;
    padding: 0.2rem 0 1.15rem 2.75rem;
    color: var(--text-muted);
    counter-increment: step;
  }

  .steps :global(li:last-child) {
    padding-bottom: 0;
  }

  /* The number, in a ring. */
  .steps :global(li)::before {
    content: counter(step);
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid rgb(70 214 224 / 0.45);
    border-radius: 50%;
    background: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--teal);
  }

  .steps--dot :global(li)::before {
    content: '';
    top: 0.55rem;
    left: 0.55rem;
    width: 0.8rem;
    height: 0.8rem;
    border-color: var(--teal);
    background: radial-gradient(circle, var(--teal) 0 35%, var(--paper) 40%);
  }

  /* The line to the next step. */
  .steps :global(li:not(:last-child))::after {
    content: '';
    position: absolute;
    top: 2.15rem;
    bottom: 0.25rem;
    left: calc(0.95rem - 0.5px);
    width: 1px;
    background: linear-gradient(rgb(70 214 224 / 0.45), var(--line));
  }

  .steps :global(li strong) {
    color: var(--text);
  }

  .steps :global(li + li) {
    margin-top: 0;
  }

  /* Side by side, with the line running across. */
  @media (min-width: 40rem) {
    .steps--row :global(ol) {
      display: grid;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      gap: 1rem;
    }

    .steps--row :global(li) {
      padding: 2.6rem 0 0;
    }

    .steps--row :global(li:not(:last-child))::after {
      top: 0.95rem;
      bottom: auto;
      left: 2.4rem;
      right: -0.6rem;
      width: auto;
      height: 1px;
      background: linear-gradient(to right, rgb(70 214 224 / 0.45), var(--line));
    }
  }
</style>
