---
export interface Props {
  number: string;
  class?: string;
}

const { number, class: className } = Astro.props;
---

<p class:list={['section-label', className]}>
  <span class="section-label__number">{number}</span>
  <span class="section-label__rule" aria-hidden="true"></span>
  <span class="section-label__text"><slot /></span>
</p>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .section-label__number {
    color: var(--teal);
  }

  .section-label__rule {
    width: 2.5rem;
    height: 1px;
    background: linear-gradient(90deg, var(--teal), var(--line-strong));
  }
</style>
