---
import { Picture } from 'astro:assets';
import SectionLabel from '../SectionLabel.astro';
import Compare from './Compare.astro';
import snap from '../../assets/screenshots/snap.webp';
import snapLayouts from '../../assets/screenshots/snap-layouts.webp';
import taskView from '../../assets/screenshots/task-view.webp';
import altTab from '../../assets/screenshots/alt-tab-crop.webp';
import panels from '../../assets/screenshots/panels.webp';
import contextMenu from '../../assets/screenshots/context-menu.webp';
import lock from '../../assets/screenshots/lock.webp';

const fmt: ('avif' | 'webp')[] = ['avif', 'webp'];
const wide = [640, 960, 1280, 1600, 1920];

const shell = [
  { name: 'Quick settings', keys: ['Super', 'A'], text: 'Wi-Fi, Bluetooth, power mode, Night light, brightness, and a sound page for each app’s volume and output.' },
  { name: 'Notification center', keys: ['Super', 'N'], text: 'Notifications with actions, a calendar, and Do Not Disturb.' },
  { name: 'Clipboard history', keys: ['Super', 'V'], text: 'Text and images, with pinned items that survive a reboot.' },
  { name: 'Snipping tool', keys: ['Super', 'Shift', 'S'], text: 'A rectangle, a window or the full screen, to the clipboard and to Pictures.' },
];
---

<section id="desktop" class="desktop" aria-labelledby="desktop-title">
  <!-- Opening -->
  <header class="desktop__intro container--wide">
    <SectionLabel number="02">The desktop</SectionLabel>
    <h2 id="desktop-title" class="desktop__title" data-reveal>
      One desktop, designed as a&nbsp;whole.
    </h2>
    <p class="desktop__lede" data-reveal style="--reveal-delay: 80ms">
      A coherent shell, polished motion, snap layouts, virtual desktops, quick settings,
      notifications and a file manager — built together, rather than gathered from unrelated
      utilities.
    </p>
  </header>

  <!-- A. Snap: the full scene with a close-up layered over it -->
  <article class="snap container--wide" aria-labelledby="snap-title">
    <figure class="snap__main" data-reveal="focus">
      <div class="shot">
        <Picture
          src={snap}
          formats={fmt}
          fallbackFormat="webp"
          widths={wide}
          sizes="(max-width: 64rem) 94vw, 70vw"
          alt="Files and Settings snapped side by side, each taking half of the screen."
        />
      </div>
    </figure>

    <figure class="snap__detail" data-reveal style="--reveal-delay: 160ms">
      <div class="shot">
        <Picture
          src={snapLayouts}
          formats={fmt}
          fallbackFormat="webp"
          widths={[400, 800]}
          sizes="(max-width: 64rem) 80vw, 34vw"
          alt="Close-up of the snap layouts flyout under a window's maximize button, offering six arrangements."
        />
      </div>
      <figcaption class="caption">
        <span class="label">Detail</span> The flyout appears over the maximize button.
      </figcaption>
    </figure>

    <div class="snap__text" data-reveal>
      <p class="label label--accent">Snap</p>
      <h3 id="snap-title" class="feature-title">Halves, quarters, and six layouts.</h3>
      <p>
        Drag a window to an edge or a corner, use <kbd>Super</kbd> + arrows, or hover the maximize
        button — <kbd>Super</kbd> <kbd>Z</kbd> from the keyboard. Snap Assist offers your other
        windows for the empty space, and windows arranged together form a snap group that the
        taskbar shows and restores as one.
      </p>
    </div>
  </article>

  <!-- B. Task View and Alt+Tab -->
  <article class="tasks container--wide" aria-labelledby="tasks-title">
    <div class="tasks__text" data-reveal>
      <p class="label label--accent">Task View</p>
      <h3 id="tasks-title" class="feature-title">Every window, every desktop, at a glance.</h3>
      <p>
        <kbd>Super</kbd> <kbd>Tab</kbd> shows live previews of your windows and your virtual
        desktops. Drag windows between desktops, rename and reorder them, and move between them
        with <kbd>Super</kbd> <kbd>Ctrl</kbd> <kbd>←</kbd> <kbd>→</kbd> and a sliding animation.
        Your desktops are remembered across sessions.
      </p>
    </div>

    <figure class="tasks__main" data-reveal="focus">
      <div class="shot">
        <Picture
          src={taskView}
          formats={fmt}
          fallbackFormat="webp"
          widths={wide}
          sizes="(max-width: 64rem) 94vw, 64vw"
          alt="Task View: previews of three windows above a row of two virtual desktops and a button to add a new one."
        />
      </div>
    </figure>

    <figure class="tasks__switcher" data-reveal>
      <div class="shot">
        <Picture
          src={altTab}
          formats={fmt}
          fallbackFormat="webp"
          widths={[446, 892]}
          sizes="(max-width: 64rem) 94vw, 46vw"
          alt="The Alt+Tab switcher with live previews of three windows, the middle one selected."
        />
      </div>
      <figcaption class="caption">
        <strong>Alt+Tab</strong> with live previews, minimized windows included. A quick press
        simply switches, without showing the panel.
      </figcaption>
    </figure>
  </article>

  <!-- C. Light and dark -->
  <article class="modes container--wide" aria-labelledby="modes-title">
    <div class="modes__head">
      <div data-reveal>
        <p class="label label--accent">Light and dark</p>
        <h3 id="modes-title" class="feature-title">Switched instantly, for the shell and for&nbsp;apps.</h3>
      </div>
      <p class="modes__text" data-reveal style="--reveal-delay: 80ms">
        One coordinated accent palette, applied to KDE and GTK apps too. Shown here: Files, Vela’s
        own file manager — tabs, breadcrumbs, a preview pane, and a first frame in about 100&nbsp;ms.
        <span class="modes__hint">Drag across the image to compare.</span>
      </p>
    </div>
    <div data-reveal="focus">
      <Compare />
    </div>
  </article>

  <!-- D. The shell -->
  <article class="shell container--wide" aria-labelledby="shell-title">
    <figure class="shell__panels" data-reveal="focus">
      <div class="shot">
        <Picture
          src={panels}
          formats={fmt}
          fallbackFormat="webp"
          widths={[440, 880]}
          sizes="(max-width: 48rem) 94vw, 40vw"
          alt="Quick settings with Wi-Fi, Bluetooth, airplane mode and volume, next to the notification center with three notifications and a calendar."
        />
      </div>
    </figure>

    <div class="shell__body">
      <div data-reveal>
        <p class="label label--accent">The shell</p>
        <h3 id="shell-title" class="feature-title">Quick to reach, and out of the way.</h3>
        <p class="shell__lede">
          Panels and menus sit on a live acrylic blur drawn by the compositor. The Start menu
          appears on the next frame after the key, context menus on the next frame after the click.
        </p>
      </div>

      <ol class="shell__list" role="list">
        {
          shell.map((item, i) => (
            <li data-reveal style={`--reveal-delay: ${i * 70}ms`}>
              <span class="shell__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="shell__name">
                  {item.name}
                  <span class="shell__keys">
                    {item.keys.map((k) => <kbd>{k}</kbd>)}
                  </span>
                </p>
                <p class="shell__desc">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <figure class="shell__menu" data-reveal>
        <div class="shot">
          <Picture
            src={contextMenu}
            formats={fmt}
            fallbackFormat="webp"
            widths={[400, 800]}
            sizes="(max-width: 48rem) 94vw, 30vw"
            alt="The desktop context menu, with View, Sort by, Refresh, New, display settings, Personalize and Open in Terminal."
          />
        </div>
        <figcaption class="caption">
          <strong>Context menus</strong> with a compact primary view; KDE service menus wait under
          “Show more options”.
        </figcaption>
      </figure>
    </div>
  </article>

  <!-- E. Reliability: the lock screen dissolves into the next chapter -->
  <article class="session" aria-labelledby="session-title">
    <div class="session__image">
      <Picture
        src={lock}
        formats={fmt}
        fallbackFormat="webp"
        widths={wide}
        sizes="100vw"
        alt="The Vela lock screen: the time and date over the default wallpaper."
        loading="lazy"
      />
    </div>
    <div class="session__text container--wide">
      <div class="session__copy" data-reveal>
        <p class="label label--accent">A session you can rely on</p>
        <h3 id="session-title" class="feature-title">A crash is not the end of the session.</h3>
        <p>
          A tiny supervisor holds the Wayland socket. If the compositor crashes, a new one starts on
          the same socket, and Qt and KDE apps reconnect and reappear. If the screen was locked,
          Vela comes back locked: the lock screen is built on <code>ext-session-lock</code>, so a
          crash never reveals the desktop.
        </p>
      </div>
    </div>
  </article>
</section>

<style>
  .desktop {
    position: relative;
    padding-top: var(--space-section);
  }

  /* ── Intro ── */
  .desktop__intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-l);
    margin-bottom: var(--space-3xl);
  }

  .desktop__intro > :global(.section-label) {
    grid-column: 1 / -1;
  }

  .desktop__title {
    grid-column: 1 / span 7;
    font-size: var(--step-5);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--tracking-display);
  }

  .desktop__lede {
    grid-column: 9 / -1;
    align-self: end;
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .feature-title {
    margin-top: 0.75rem;
    font-size: var(--step-3);
    line-height: 1.08;
    letter-spacing: var(--tracking-tight);
  }

  .feature-title + p,
  .shell__lede {
    margin-top: var(--space-s);
    color: var(--text-muted);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text);
    white-space: nowrap;
  }

  figure .caption {
    margin-top: var(--space-s);
  }

  .caption .label {
    margin-right: 0.6rem;
  }

  /* ── A. Snap ── */
  .snap {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-l);
  }

  .snap__main {
    grid-column: 1 / span 9;
    grid-row: 1;
  }

  .snap__detail {
    grid-column: 8 / -1;
    grid-row: 1 / span 2;
    align-self: end;
    margin-bottom: calc(var(--space-xl) * -1);
    z-index: 1;
  }

  .snap__detail .shot {
    box-shadow:
      var(--shadow-window),
      0 0 0 1px rgb(70 214 224 / 0.25);
  }

  .snap__text {
    grid-column: 1 / span 5;
    grid-row: 2;
    padding-top: var(--space-m);
  }

  /* ── B. Task View ── */
  .tasks {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-xl);
    margin-top: var(--space-section);
  }

  .tasks__text {
    grid-column: 1 / span 4;
    grid-row: 1;
    align-self: center;
  }

  .tasks__main {
    grid-column: 5 / -1;
    grid-row: 1;
  }

  .tasks__switcher {
    grid-column: 2 / span 7;
    grid-row: 2;
    margin-top: calc(var(--space-2xl) * -1);
    z-index: 1;
  }

  .tasks__switcher .caption {
    max-width: 30rem;
  }

  /* ── C. Light and dark ── */
  .modes {
    margin-top: var(--space-section);
  }

  .modes__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-m);
    align-items: end;
    margin-bottom: var(--space-xl);
  }

  .modes__head > div {
    grid-column: 1 / span 6;
  }

  .modes__text {
    grid-column: 8 / -1;
    color: var(--text-muted);
  }

  .modes__hint {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }

  :global(html:not(.js)) .modes__hint {
    display: none;
  }

  /* ── D. Shell ── */
  .shell {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: var(--space-xl);
    margin-top: var(--space-section);
    align-items: start;
  }

  .shell__panels {
    grid-column: 1 / span 5;
    position: sticky;
    top: calc(var(--header-height) + 2rem);
  }

  .shell__body {
    grid-column: 7 / -1;
  }

  .shell__list {
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .shell__list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--space-s);
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .shell__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--teal);
    padding-top: 0.3rem;
  }

  .shell__name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.015em;
  }

  .shell__keys {
    display: inline-flex;
    gap: 0.3rem;
    font-size: var(--step--1);
    font-weight: 400;
  }

  .shell__desc {
    margin-top: 0.3rem;
    color: var(--text-muted);
  }

  .shell__menu {
    width: min(100%, 26rem);
    margin-top: var(--space-2xl);
    margin-left: auto;
  }

  /* ── E. Session ── */
  .session {
    position: relative;
    margin-top: var(--space-section);
    isolation: isolate;
  }

  .session__image {
    position: relative;
    z-index: -1;
    max-height: 56rem;
    overflow: hidden;
  }

  .session__image :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .session__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--ink-1) 0%, transparent 18%, transparent 55%, var(--ink-1) 100%),
      linear-gradient(90deg, transparent 45%, rgb(5 11 21 / 0.55) 100%);
  }

  .session__text {
    position: absolute;
    inset: auto 0 12%;
    display: flex;
    justify-content: flex-end;
  }

  .session__copy {
    max-width: 30rem;
  }

  .session__copy p:last-child {
    margin-top: var(--space-s);
    color: var(--text-muted);
  }

  /* ── Tablet ── */
  @media (max-width: 64rem) {
    .desktop__title,
    .desktop__lede {
      grid-column: 1 / -1;
    }

    .snap__main {
      grid-column: 1 / -1;
    }

    .snap__detail {
      grid-column: 4 / -1;
      grid-row: 2;
      margin-top: calc(var(--space-3xl) * -1);
      margin-bottom: 0;
    }

    .snap__text {
      grid-column: 1 / span 10;
      grid-row: 3;
    }

    .tasks__text,
    .tasks__main {
      grid-column: 1 / -1;
    }

    .tasks__main {
      grid-row: 2;
    }

    .tasks__switcher {
      grid-column: 1 / span 10;
      grid-row: 3;
      margin-top: calc(var(--space-xl) * -1);
      margin-left: var(--space-l);
    }

    .modes__head > div,
    .modes__text {
      grid-column: 1 / -1;
    }

    .session__text {
      position: static;
      margin-top: calc(var(--space-3xl) * -1);
    }
  }

  @media (max-width: 48rem) {
    .shell__panels,
    .shell__body {
      grid-column: 1 / -1;
    }

    .shell__panels {
      position: static;
      width: min(100%, 26rem);
    }

    .shell__menu {
      margin-left: 0;
    }
  }

  @media (max-width: 40rem) {
    .snap__detail {
      grid-column: 2 / -1;
      margin-top: calc(var(--space-xl) * -1);
    }

    .snap__text {
      grid-column: 1 / -1;
    }

    .tasks__switcher {
      grid-column: 1 / -1;
      margin-left: var(--space-m);
      margin-top: calc(var(--space-l) * -1);
    }

    .session__image {
      aspect-ratio: 4 / 3;
    }

    .session__image :global(img) {
      height: 100%;
      object-position: 48% 0%;
    }

    .session__text {
      margin-top: calc(var(--space-xl) * -1);
    }
  }
</style>
