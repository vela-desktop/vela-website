---
import Logo from './Logo.astro';
import { LINKS, SITE } from '../consts';

const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: 'Explore',
    links: [
      { label: 'The desktop', href: '/#desktop' },
      { label: 'Philosophy', href: '/#philosophy' },
      { label: 'Journal', href: '/blog/' },
      { label: 'RSS feed', href: LINKS.rss },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'Source code', href: LINKS.repo, external: true },
      { label: 'Install', href: LINKS.install },
      { label: 'FAQ', href: LINKS.faq },
      { label: 'Documentation', href: LINKS.docs, external: true },
      { label: 'Issues', href: LINKS.issues, external: true },
    ],
  },
  {
    title: 'About',
    links: [
      { label: 'Roadmap', href: LINKS.roadmap, external: true },
      { label: 'Contributing', href: LINKS.contributing, external: true },
      { label: 'License', href: LINKS.license, external: true },
      { label: 'Website source', href: LINKS.website, external: true },
      { label: 'Privacy', href: LINKS.privacy },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container--wide">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="/" aria-label="Vela — home">
          <Logo size={36} />
          <span aria-hidden="true">Vela</span>
        </a>
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <p class="site-footer__status">
          <span class="dot" aria-hidden="true"></span>
          Alpha software — usable every day, still changing quickly.
        </p>
      </div>

      {
        columns.map((column) => (
          <nav class="site-footer__col" aria-label={column.title}>
            <h2 class="label">{column.title}</h2>
            <ul role="list">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} rel={link.external ? 'noopener' : undefined}>
                    {link.label}
                    {link.external && (
                      <span class="arrow arrow--ne" aria-hidden="true">
                        ↗
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p>
        Vela is free software, licensed under the{' '}
        <a href={LINKS.license} rel="noopener">GNU General Public License v3.0 or later</a>.{' '}
        Screenshots and artwork come from the Vela repository under the same license.
      </p>
      <p class="site-footer__mark">
        <span>Modern.</span> <span>Fluid.</span> <span>Sharp.</span>
        <span class="site-footer__year">© {year}</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding-block: var(--space-3xl) var(--space-xl);
    background: var(--ink-0);
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 2fr) repeat(3, minmax(0, 1fr));
    gap: var(--space-xl) var(--gutter);
    padding-bottom: var(--space-2xl);
  }

  .site-footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
  }

  .site-footer__tagline {
    max-width: 22rem;
    margin-top: var(--space-m);
    font-size: var(--step-0);
    color: var(--text);
  }

  .site-footer__status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: var(--space-m);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 10px var(--coral);
  }

  .site-footer__col ul {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .site-footer__col a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) linear;
  }

  .site-footer__col a:hover {
    color: var(--text);
  }

  .site-footer__col .arrow {
    margin-left: 0.2em;
    font-size: 0.85em;
    color: var(--text-faint);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-m) var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
    font-size: var(--step--2);
    line-height: 1.6;
    color: var(--text-faint);
  }

  .site-footer__bottom p:first-child {
    max-width: 44rem;
  }

  .site-footer__bottom a {
    color: var(--text-muted);
  }

  .site-footer__mark {
    display: flex;
    gap: 0.6em;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-footer__year {
    margin-left: 0.8em;
    color: var(--text-faint);
  }

  @media (max-width: 60rem) {
    .site-footer__top {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 36rem) {
    .site-footer__top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
