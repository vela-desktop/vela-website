---
// Vela's logo (images/vela_icon.svg from the Vela repository), inlined.
import VelaIcon from '../assets/brand/vela_icon.svg';

export interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className } = Astro.props;
---

<span class:list={['logo', className]} style={`--logo-size: ${size}px`}>
  <VelaIcon width={size} height={size} aria-hidden="true" focusable="false" />
</span>

<style>
  .logo {
    display: inline-block;
    flex: none;
    width: var(--logo-size);
    height: var(--logo-size);
    overflow: hidden;
    border-radius: calc(var(--logo-size) * 0.22);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 4px 14px -4px rgb(0 0 0 / 0.6);
  }

  .logo :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
