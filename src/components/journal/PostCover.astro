---
import { Picture } from 'astro:assets';
import wallpaper from '../../assets/brand/vela-wallpaper.svg?url';
import { seed, type Post } from '../../lib/posts';
import { ENTRY_COVERS } from './covers';

export interface Props {
  post?: Post;
  /** Shown on generated covers, e.g. "Entry 03". */
  kicker?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const { post, kicker, sizes = '(max-width: 64rem) 94vw, 60vw', eager = false, class: className } = Astro.props;
const cover = post?.data.cover;
const drawn = !cover && post ? ENTRY_COVERS[post.id] : undefined;

// Entries without a cover use the one drawn for them (covers/index.ts), or
// else a composition cut from Vela's wallpaper. The
// crop, scale and hue are derived from the entry's id: stable between builds,
// different between entries. The hue stays within ±18°, the way Vela's own
// wallpaper set varies one design across colors.
const n = seed(post?.id ?? 'journal');
const pick = (shift: number, range: number) => ((n >>> shift) % 1000) / 1000 * range;
const originX = 20 + pick(0, 60);
const scale = Number((1.15 + pick(10, 0.9)).toFixed(2));
const flip = (n & 1) === 0 ? 1 : -1;
// Mirroring around the zoom origin would pull one edge of the image inside the
// frame. Moving the origin to (x + s·(100 − x)) / (1 + s) gives the same result
// as mirroring around the center and then zooming in on x, so the image always
// fills the frame.
const transformX = flip === 1 ? originX : (originX + scale * (100 - originX)) / (1 + scale);
const style = [
  `--cover-x: ${transformX.toFixed(1)}%`,
  `--cover-y: ${Math.round(10 + pick(5, 50))}%`,
  `--cover-scale: ${scale}`,
  `--cover-hue: ${Math.round(-18 + pick(15, 36))}deg`,
  `--cover-flip: ${flip}`,
].join('; ');
const firstTag = post?.data.tags[0];
---

<div class:list={['cover', { 'cover--generated': !cover }, className]}>
  {
    cover ? (
      <Picture
        src={cover}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        alt={post?.data.coverAlt ?? ''}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class:list={['cover__art', { 'cover__art--drawn': drawn }]} style={drawn ? undefined : style} aria-hidden="true">
        {drawn ? (
          <drawn.component {...drawn.props} {...(drawn.image ? { sizes, eager } : {})} />
        ) : (
          <img src={wallpaper} alt="" width="1920" height="1073" loading={eager ? 'eager' : 'lazy'} decoding="async" />
        )}
        <span class="cover__meta">
          <span>Vela Journal</span>
          {kicker && <span>{kicker}</span>}
        </span>
        {firstTag && <span class="cover__tag">{firstTag}</span>}
      </div>
    )
  }
</div>

<style>
  .cover {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-m);
    background: var(--navy);
    aspect-ratio: var(--cover-ratio, 16 / 10);
    box-shadow: 0 0 0 1px var(--line);
  }

  .cover :global(picture) {
    display: block;
    height: 100%;
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms var(--ease-expressive);
  }

  .cover__art {
    position: absolute;
    inset: 0;
  }

  .cover__art:not(.cover__art--drawn) img {
    transform-origin: var(--cover-x) var(--cover-y);
    transform: scale(var(--cover-scale)) scaleX(var(--cover-flip));
    filter: hue-rotate(var(--cover-hue)) saturate(1.1);
  }

  .cover__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(2 6 12 / 0.15), rgb(2 6 12 / 0.55)),
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.035) 0 1px, transparent 1px calc(100% / 12));
  }

  /* Drawn covers only need the corners darkened, for the number and tag. */
  .cover__art--drawn::after {
    background: linear-gradient(180deg, rgb(2 6 12 / 0.45), transparent 20%, transparent 80%, rgb(2 6 12 / 0.45));
  }

  .cover__meta,
  .cover__tag {
    position: absolute;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.85);
  }

  .cover__meta {
    top: 1rem;
    left: 1rem;
    right: 1rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .cover__tag {
    left: 1rem;
    bottom: 1rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: var(--radius-pill);
    background: rgb(2 6 12 / 0.35);
  }

  /* Hover: the image drifts closer — linked from the parent card */
  :global(a:hover) .cover :global(img),
  :global(a:focus-visible) .cover :global(img) {
    transform: scale(1.035);
  }

  :global(a:hover) .cover__art:not(.cover__art--drawn) img,
  :global(a:focus-visible) .cover__art:not(.cover__art--drawn) img {
    transform: scale(calc(var(--cover-scale) * 1.04)) scaleX(var(--cover-flip));
  }

  @media (prefers-reduced-motion: reduce) {
    .cover :global(img) {
      transition: none;
    }
  }
</style>
