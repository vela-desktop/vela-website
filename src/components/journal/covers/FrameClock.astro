---
// Cover of "Following the monitor, not a timer": when a frame is drawn
// against the 60 Hz refreshes. Drawn to scale (180 units = 16.7 ms): a timer
// draws right after a refresh and the frame waits until the next one; Vela
// draws just before it, 1.1–1.9 ms from drawing to light (the entry's table).
import './covers.css';

const vblanks = [170, 350, 530, 710];
const frame = 14; // ≈ 1.3 ms of drawing at this scale
---

<svg class="cd" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
  {vblanks.map((x) => <line class="cd-line cd-line--bright" x1={x} y1="128" x2={x} y2="388" />)}
  <text class="cd-label" x={vblanks[0]} y="112" text-anchor="middle">vblank</text>
  <text class="cd-label" x={vblanks[3]} y="112" text-anchor="middle">60 Hz</text>

  <text class="cd-label cd-label--strong" x="60" y="196">Timer</text>
  <line class="cd-line" x1="150" y1="210" x2="740" y2="210" />
  {vblanks.slice(0, 3).map((x) => <rect class="cd-fill-bright" x={x + 2} y="186" width={frame} height="24" rx="2" />)}
  <path class="cd-line" d={`M ${vblanks[1] + 2} 236 H ${vblanks[2] - 4}`} marker-end="url(#fc-arrow)" />
  <text class="cd-value" x={(vblanks[1] + vblanks[2]) / 2} y="284" text-anchor="middle">16.7 ms</text>

  <text class="cd-label cd-label--teal" x="60" y="336">Vela</text>
  <line class="cd-line" x1="150" y1="350" x2="740" y2="350" />
  {vblanks.slice(1).map((x) => <rect class="cd-fill-teal" x={x - frame - 2} y="326" width={frame} height="24" rx="2" />)}
  <text class="cd-value cd-value--teal" x={vblanks[2] - 24} y="420" text-anchor="end">1.1–1.9 ms</text>
  <path class="cd-line cd-line--teal" d={`M ${vblanks[2] - 16} 404 L ${vblanks[2] - 9} 362`} />

  <defs>
    <marker id="fc-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
      <path class="cd-line cd-line--bright" d="M 0 0 L 10 5 L 0 10" />
    </marker>
  </defs>
</svg>
