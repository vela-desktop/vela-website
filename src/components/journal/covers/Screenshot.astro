---
// A cover made of real Vela captures from src/assets/screenshots, cropped but
// never edited. With `light`, the capture is split diagonally with the same
// scene in light mode, as on the homepage.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Props as PictureProps } from 'astro/components/Picture.astro';

export interface Props {
  src: ImageMetadata;
  light?: ImageMetadata;
  sizes: string;
  eager?: boolean;
}

const { src, light, sizes, eager = false } = Astro.props;
const shared = {
  formats: ['avif', 'webp'],
  fallbackFormat: 'webp',
  widths: [480, 800, 1200, 1600],
  sizes,
  alt: '',
  loading: eager ? 'eager' : 'lazy',
} satisfies Partial<PictureProps>;
---

<div class="shot">
  <Picture src={src} {...shared} fetchpriority={eager ? 'high' : undefined} />
  {
    light && (
      <>
        <div class="shot__light">
          <Picture src={light} {...shared} />
        </div>
        <span class="shot__divider" />
      </>
    )
  }
</div>

<style>
  .shot,
  .shot__light {
    position: absolute;
    inset: 0;
  }

  .shot__light {
    clip-path: polygon(58% 0, 100% 0, 100% 100%, 42% 100%);
  }

  .shot :global(picture) {
    display: block;
    height: 100%;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A thin band along the edge of the light half. */
  .shot__divider {
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0.75);
    clip-path: polygon(57.85% 0, 58.15% 0, 42.15% 100%, 41.85% 100%);
  }
</style>
