---
import PostCover from './PostCover.astro';
import PostMeta from './PostMeta.astro';
import { postUrl, type Post } from '../../lib/posts';

export interface Props {
  post: Post;
  number: number;
  /** Visual weight: "large" gets a wider cover and a bigger title. */
  size?: 'large' | 'small';
  headingLevel?: 'h2' | 'h3';
}

const { post, number, size = 'small', headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const kicker = `Entry ${String(number).padStart(2, '0')}`;
---

<article class:list={['card', `card--${size}`]}>
  <a class="card__link" href={postUrl(post)}>
    <PostCover post={post} kicker={kicker} class="card__cover" sizes={size === 'large' ? '(max-width: 48rem) 94vw, 56vw' : '(max-width: 48rem) 94vw, 38vw'} />
    <div class="card__body">
      <PostMeta post={post} />
      <Heading class="card__title">{post.data.title}</Heading>
      <p class="card__description">{post.data.description}</p>
    </div>
  </a>
</article>

<style>
  .card__link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-m);
  }

  .card--large :global(.card__cover) {
    --cover-ratio: 16 / 10;
  }

  .card--small :global(.card__cover) {
    --cover-ratio: 5 / 4;
  }

  .card__body {
    padding-top: var(--space-m);
  }

  .card__title {
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-weight: 450;
    line-height: 1.1;
    letter-spacing: -0.02em;
    transition: color var(--duration-normal) linear;
  }

  .card--large .card__title {
    font-size: var(--step-4);
  }

  .card--small .card__title {
    font-size: var(--step-3);
  }

  .card__description {
    margin-top: 0.75rem;
    color: var(--text-muted);
  }

  .card__link:hover .card__title {
    color: var(--accent);
  }
</style>
