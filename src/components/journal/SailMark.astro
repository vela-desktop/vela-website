---
// Vela's sail symbol — the Start button glyph (shell/qml/StartGlyph.qml),
// redrawn from the same coordinates. Used as the journal's end mark.
export interface Props {
  size?: number;
}

const { size = 22 } = Astro.props;
---

<svg class="sail" width={size} height={size} viewBox="0 0 22 22" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="sail-gradient" x1="12" y1="1" x2="21" y2="16" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#bfe4ff"></stop>
      <stop offset="1" stop-color="#4da3ff"></stop>
    </linearGradient>
  </defs>
  <path d="M12 1 21 16H12Z" fill="url(#sail-gradient)"></path>
  <path d="M10 5V16H3Z" fill="#bfe4ff"></path>
  <path d="M1 18H21L17.5 21.5H4.5Z" fill="#4da3ff"></path>
</svg>
