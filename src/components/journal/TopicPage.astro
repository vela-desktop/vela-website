---
// The entries on one topic, in one language: /blog/topics/<tag>/ and
// /it/blog/topics/<tag>/.
import Base from '../../layouts/Base.astro';
import JournalLayout from './JournalLayout.astro';
import { journalUrl, topicUrl, type Entry } from '../../lib/posts';
import { breadcrumbSchema } from '../../lib/schema';
import { DEFAULT_LANG, UI, tagName, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
  tag: string;
  posts: Entry[];
  /** Every entry of the journal, for numbering. */
  allPosts: Entry[];
  /** The languages this topic has entries in, for the alternate links. */
  languages: Lang[];
}

const { lang = DEFAULT_LANG, tag, posts, allPosts, languages } = Astro.props;
const ui = UI[lang];
const words = ui.topic;
const name = tagName(tag, lang);
const count = ui.entries(posts.length);
---

<Base
  title={words.title(name)}
  description={words.description(count, name)}
  lang={lang}
  alternates={languages.map((other) => ({ lang: other, path: topicUrl(tag, other) }))}
  jsonLd={[
    breadcrumbSchema([
      ['Vela', '/'],
      ['Journal', journalUrl(lang)],
      [name, topicUrl(tag, lang)],
    ]),
  ]}
>
  <div class="topic-page">
    <header class="topic container--wide">
      <div class="topic__rule" aria-hidden="true">
        <span>Vela Journal</span>
        <span>{words.rule}</span>
        <span>{count}</span>
      </div>
      <h1 class="topic__title">{name}</h1>
      <p class="topic__foot">
        <span>{words.tagged(count, name)}</span>
        <a class="link" href={journalUrl(lang)}><span class="arrow arrow--back" aria-hidden="true">←</span> {words.all}</a>
      </p>
    </header>

    <div class="container--wide topic-page__body">
      <JournalLayout posts={posts} allPosts={allPosts} headingLevel="h2" groupByYear eager />
    </div>
  </div>
</Base>

<style>
  .topic-page {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-section);
    background:
      radial-gradient(60rem 30rem at 85% 0%, rgb(70 214 224 / 0.07), transparent 70%),
      linear-gradient(180deg, var(--ink-1), var(--paper) 30rem);
  }

  .topic__rule {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .topic__title {
    margin-top: var(--space-l);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 1rem + 8vw, 8rem);
    font-style: italic;
    font-weight: 360;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--teal);
    overflow-wrap: anywhere;
  }

  .topic__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.75rem;
    margin-top: var(--space-xl);
    padding-bottom: var(--space-l);
    border-bottom: 1px solid var(--line-strong);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .topic__foot a {
    font-weight: 500;
  }

  .topic-page__body {
    margin-top: var(--space-xl);
  }

  @media (max-width: 40rem) {
    .topic__rule span:first-child {
      display: none;
    }
  }
</style>
