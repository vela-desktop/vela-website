---
import { formatDate, readingTime, type Entry } from '../../lib/posts';
import { DEFAULT_LANG, UI } from '../../lib/i18n';

export interface Props {
  post: Entry;
  class?: string;
}

const { post, class: className } = Astro.props;
const lang = post.lang ?? DEFAULT_LANG;
const minutes = readingTime(post);
---

<p class:list={['post-meta', className]}>
  {post.data.draft && <span class="post-meta__draft">{UI[lang].draft}</span>}
  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
  <span aria-hidden="true">·</span>
  <span>{UI[lang].minRead(minutes)}</span>
</p>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .post-meta__draft {
    padding: 0.1rem 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--coral);
    color: var(--ink-0);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
