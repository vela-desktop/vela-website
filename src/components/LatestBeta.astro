---
// The newest Beta release (src/lib/vela.ts), on the Install and What's new
// pages. Renders nothing when GitHub couldn't be reached or there is no
// release yet.
import { latestBeta } from '../lib/vela';
import { formatDate } from '../lib/posts';

export interface Props {
  /** Link to the What's new page (on Install) or to the install steps. */
  more: 'changes' | 'install';
}

const { more } = Astro.props;
const release = await latestBeta();
const megabytes = (bytes: number) => (bytes / 1_000_000).toFixed(1);
---

{
  release && (
    <aside class="build" aria-label="Latest Beta release">
      <p class="build__label label label--accent">Latest Beta</p>
      <p class="build__version">Vela {release.version}</p>
      <p class="build__meta">
        <time datetime={release.published.toISOString()}>{formatDate(release.published)}</time>
        {release.packages.map((pkg) => (
          <>
            <span aria-hidden="true">·</span>
            <span>{pkg.label}, {megabytes(pkg.size)} MB</span>
          </>
        ))}
        <span aria-hidden="true">·</span>
        <a href={release.url} rel="noopener">Release notes on GitHub</a>
      </p>
      <p class="build__more">
        {more === 'changes' ? (
          <a href="/changes/">What’s new on main</a>
        ) : (
          <a href="/install/">Install it with vela-update</a>
        )}
      </p>
    </aside>
  )
}

<style>
  .build {
    margin-block: 1.6em;
    padding: 1.1rem 1.35rem;
    border: 1px solid var(--line);
    border-left: 2px solid var(--teal);
    border-radius: 0 var(--radius-m) var(--radius-m) 0;
    background: rgb(70 214 224 / 0.04);
    font-family: var(--font-body);
    font-size: 0.86em;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .build p {
    margin: 0;
  }

  .build__version {
    margin-top: 0.35rem !important;
    font-family: var(--font-mono);
    font-size: 1.15em;
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .build__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-faint);
  }

  @media (max-width: 40rem) {
    .build__meta {
      flex-direction: column;
    }

    .build__meta [aria-hidden] {
      display: none;
    }
  }

  .build__more {
    margin-top: 0.6rem !important;
    font-weight: 500;
  }
</style>
