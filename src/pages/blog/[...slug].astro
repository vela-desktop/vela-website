---
import { render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { getPosts, getTranslations, type Post, type TranslatedPost } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const translations = await getTranslations();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      translations: translations.filter((translation) => translation.id === post.id),
      newer: posts[i - 1],
      older: posts[i + 1],
    },
  }));
}

interface Props {
  post: Post;
  translations: TranslatedPost[];
  newer?: Post;
  older?: Post;
}

const { post, translations, newer, older } = Astro.props;
const { Content } = await render(post);
---

<Article post={post} translations={translations} newer={newer} older={older}>
  <Content />
</Article>
