---
import { Picture, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostMeta from '../../components/journal/PostMeta.astro';
import SailMark from '../../components/journal/SailMark.astro';
import { formatDate, getPosts, ogImageUrl, postUrl, type Post } from '../../lib/posts';
import { LINKS } from '../../consts';
import { articleSchema } from '../../lib/schema';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, cover, coverAlt, tags } = post.data;

const ogImage = cover
  ? (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src
  : ogImageUrl(post);
---

<Base
  title={title}
  description={description}
  type="article"
  image={ogImage}
  imageAlt={cover ? coverAlt : `${title} — Vela Journal`}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  noindex={post.data.draft}
  jsonLd={[articleSchema(post, ogImage)]}
>
  <article class="article">
    <header class="article__header">
      <a class="article__back" href="/blog/">
        <span class="arrow arrow--back" aria-hidden="true">←</span> The Journal
      </a>

      {
        tags.length > 0 && (
          <ul class="article__tags" role="list" aria-label="Topics">
            {tags.map((tag) => <li>{tag}</li>)}
          </ul>
        )
      }

      <h1 class="article__title">{title}</h1>
      <p class="article__dek">{description}</p>

      <div class="article__byline">
        <PostMeta post={post} />
        {
          updatedDate && (
            <p class="article__updated">
              Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </p>
          )
        }
      </div>
    </header>

    {
      cover && (
        <figure class="article__cover">
          <Picture
            src={cover}
            alt={coverAlt ?? ''}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="(max-width: 90rem) 94vw, 1344px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    <div class="prose article__body">
      <Content />
    </div>

    <footer class="article__end">
      <div class="article__mark">
        <span class="article__mark-rule" aria-hidden="true"></span>
        <SailMark size={22} />
        <span class="article__mark-rule" aria-hidden="true"></span>
      </div>

      <p class="article__colophon">
        Published {formatDate(pubDate)} in the Vela Journal.{' '}
        {updatedDate && <>Last updated {formatDate(updatedDate)}.{' '}</>}
        Follow along by <a href={LINKS.rss}>RSS</a>, or watch the{' '}
        <a href={LINKS.repo} rel="noopener">repository on GitHub</a>.
      </p>

      {
        (newer || older) && (
          <nav class="article__pager" aria-label="More entries">
            {older ? (
              <a class="pager pager--older" href={postUrl(older)} rel="prev">
                <span class="label">Previous entry</span>
                <span class="pager__title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="pager pager--newer" href={postUrl(newer)} rel="next">
                <span class="label">Next entry</span>
                <span class="pager__title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }

      <a class="article__all link" href="/blog/">All journal entries <span class="arrow" aria-hidden="true">→</span></a>
    </footer>
  </article>
</Base>

<style>
  .article {
    padding-top: calc(var(--header-height) + var(--space-2xl));
    padding-bottom: var(--space-section);
    background:
      radial-gradient(50rem 26rem at 50% 0%, rgb(77 163 255 / 0.07), transparent 70%),
      var(--paper);
  }

  .article__header {
    width: min(100% - 2 * var(--gutter), 56rem);
    margin-inline: auto;
    text-align: center;
  }

  .article__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--duration-fast) linear;
  }

  .article__back:hover {
    color: var(--text);
  }

  .arrow--back {
    transition: transform var(--duration-slow) var(--ease-decelerate);
  }

  .article__back:hover .arrow--back {
    transform: translateX(-0.25em);
  }

  .article__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .article__tags li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal);
  }

  .article__title {
    margin-top: var(--space-l);
    font-family: var(--font-serif);
    font-size: var(--step-5);
    font-weight: 420;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .article__tags + .article__title {
    margin-top: var(--space-m);
  }

  .article__dek {
    max-width: 40rem;
    margin: var(--space-m) auto 0;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 350;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .article__byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.25rem;
    margin-top: var(--space-l);
    padding-block: 0.9rem;
    border-block: 1px solid var(--line);
  }

  .article__byline :global(.post-meta) {
    justify-content: center;
  }

  .article__updated {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .article__cover {
    width: min(100% - 2 * var(--gutter), var(--width-page));
    margin: var(--space-2xl) auto 0;
  }

  .article__cover :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-window);
  }

  .article__body {
    margin-top: var(--space-2xl);
  }

  /* ── The ending ── */
  .article__end {
    width: min(100% - 2 * var(--gutter), var(--measure));
    margin: var(--space-3xl) auto 0;
  }

  .article__mark {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .article__mark-rule {
    flex: 1;
    height: 1px;
    background: var(--line-strong);
  }

  .article__colophon {
    margin-top: var(--space-l);
    font-family: var(--font-serif);
    font-size: var(--step-0);
    font-style: italic;
    text-align: center;
    color: var(--text-muted);
  }

  .article__colophon a {
    color: var(--text);
  }

  .article__pager {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
    margin-top: var(--space-2xl);
  }

  .pager {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--duration-normal) var(--ease-decelerate),
      background-color var(--duration-normal) var(--ease-decelerate);
  }

  .pager:hover {
    border-color: var(--line-bright);
    background: rgb(255 255 255 / 0.025);
  }

  .pager--newer {
    text-align: right;
  }

  .pager__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.25;
  }

  .article__all {
    display: table;
    margin: var(--space-xl) auto 0;
    font-size: var(--step--1);
    font-weight: 500;
  }

  @media (max-width: 40rem) {
    .article__header {
      text-align: left;
    }

    .article__tags,
    .article__byline,
    .article__byline :global(.post-meta) {
      justify-content: flex-start;
    }

    .article__dek {
      margin-left: 0;
    }

    .article__pager {
      grid-template-columns: minmax(0, 1fr);
    }

    .pager--newer {
      text-align: left;
    }
  }
</style>
