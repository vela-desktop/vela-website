---
import { slug } from 'github-slugger';
import TopicPage from '../../../components/journal/TopicPage.astro';
import { getPosts, getTranslations } from '../../../lib/posts';
import { DEFAULT_LANG, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const posts = await getPosts();
  const translations = await getTranslations();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => {
    const languages: Lang[] = [
      DEFAULT_LANG,
      ...new Set(translations.filter((post) => post.data.tags.includes(tag)).map((post) => post.lang)),
    ];
    return {
      params: { topic: slug(tag) },
      props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)), allPosts: posts, languages },
    };
  });
}

const { tag, posts, allPosts, languages } = Astro.props;
---

<TopicPage tag={tag} posts={posts} allPosts={allPosts} languages={languages} />
