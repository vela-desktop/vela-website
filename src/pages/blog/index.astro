---
import JournalIndex from '../../components/journal/JournalIndex.astro';
import { getPosts, getTranslations } from '../../lib/posts';
import { DEFAULT_LANG, type Lang } from '../../lib/i18n';

const posts = await getPosts();
// The index exists in every language at least one entry is translated into.
const languages: Lang[] = [DEFAULT_LANG, ...new Set((await getTranslations()).map((post) => post.lang))];
---

<JournalIndex posts={posts} allPosts={posts} languages={languages} />
