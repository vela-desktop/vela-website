---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import Desktop from '../components/home/Desktop.astro';
import Philosophy from '../components/home/Philosophy.astro';
import Journal from '../components/home/Journal.astro';
import OpenSource from '../components/home/OpenSource.astro';
import { softwareSchema, websiteSchema } from '../lib/schema';
import { latestAlphaBuild } from '../lib/vela';

const build = await latestAlphaBuild();
---

<Base jsonLd={[websiteSchema(), softwareSchema(build?.version)]}>
  <Hero />
  <Desktop />
  <Philosophy />
  <Journal />
  <OpenSource />
</Base>
